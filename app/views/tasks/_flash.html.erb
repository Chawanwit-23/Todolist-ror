<% if notice.present? %>
  <div class="flash-message flash-message--notice mb-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800"><%= notice %></div>
<% end %>

<% if alert.present? %>
  <div class="flash-message flash-message--alert mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"><%= alert %></div>
<% end %>
