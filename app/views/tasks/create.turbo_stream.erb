<%= turbo_stream.update "flash-messages", partial: "tasks/flash" %>
<%= turbo_stream.replace "task-form", partial: "tasks/form", locals: { task: @task } %>
<%= turbo_stream.replace "task-summary", partial: "tasks/summary", locals: { tasks: @tasks } %>

<% if @view_mode == "calendar" %>
  <%= turbo_stream.update "task-calendar-container", partial: "tasks/calendar" %>
<% elsif @tasks.one? %>
  <%= turbo_stream.update "task-list-container", partial: "tasks/list", locals: { tasks: @tasks } %>
<% else %>
  <%= turbo_stream.append "task-list", partial: "tasks/task", locals: { task: @created_task } %>
<% end %>

<%= turbo_stream.update "todo-count", @tasks.count %>
